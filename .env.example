# ─── Server ────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
API_PREFIX=/api/v1

# ─── PostgreSQL (PostGIS) ───────────────────────────────────────────────────
DATABASE_URL=postgres://parkpeer:parkpeer@localhost:5432/parkpeer

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── Booking engine ─────────────────────────────────────────────────────────
BOOKING_LOCK_TTL_SECONDS=600        # 10-minute SpotLock
CHECKIN_GEOFENCE_METERS=50          # max distance for GPS check-in
QR_TOKEN_TTL_SECONDS=60             # rotating QR lifetime
OVERSTAY_GRACE_MINUTES=15           # overstay billing only beyond this
PLATFORM_COMMISSION_RATE=0.15       # 15% take rate

# ─── Payments: only configure ONE provider ──────────────────────────────────
PAYMENT_PROVIDER=mock               # mock | razorpay | stripe
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Firebase Cloud Messaging ───────────────────────────────────────────────
FCM_SERVICE_ACCOUNT_PATH=           # path to firebase-adminsdk service account JSON

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGIN=*