# ParkPeer backend — development template.
# Copy to backend/.env (`cp .env.example backend/.env`) and start the local
# stack with `docker compose up -d postgres redis`.
# For a deploy, start from backend/.env.production.example: it sets
# NODE_ENV=production, which makes the server refuse to boot on a placeholder
# value or a wildcard CORS origin.

# ─── Server ────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
API_PREFIX=/api/v1
LOG_LEVEL=info                      # pino level: trace|debug|info|warn|error

# ─── PostgreSQL (PostGIS) ───────────────────────────────────────────────────
DATABASE_URL=postgres://parkpeer:parkpeer@localhost:5432/parkpeer
DATABASE_SSL=false                  # true for managed Postgres (Supabase/Neon/RDS)
DATABASE_SSL_NO_VERIFY=false        # only if the provider's CA is not in the image

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379    # rediss://… for TLS (Upstash, Redis Cloud)

# ─── JWT ────────────────────────────────────────────────────────────────────
# Production requires 32+ characters that are not a placeholder.
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── Booking engine ─────────────────────────────────────────────────────────
BOOKING_LOCK_TTL_SECONDS=600        # 10-minute SpotLock
CHECKIN_GEOFENCE_METERS=50          # max distance for GPS check-in
QR_TOKEN_TTL_SECONDS=60             # rotating QR lifetime
OVERSTAY_GRACE_MINUTES=15           # overstay billing only beyond this
PLATFORM_COMMISSION_RATE=0.15       # 15% take rate

# ─── Payments: only configure ONE provider ──────────────────────────────────
PAYMENT_PROVIDER=mock               # mock | razorpay | stripe
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Required in production when PAYMENT_PROVIDER=mock: the mock gateway has no
# signature to verify, so the confirmation webhook demands this shared secret
# (header `X-Mock-Payment-Secret`). Without it anyone could confirm a booking
# for free.
MOCK_PAYMENT_SECRET=

# ─── Operator accounts ──────────────────────────────────────────────────────
# Admin accounts cannot be self-registered. Either set this (the API then asks
# for `admin_secret` alongside `role: "admin"`), or promote an operator:
#   UPDATE public.users SET role = 'admin' WHERE email = 'ops@example.com';
ADMIN_SIGNUP_SECRET=

# ─── Firebase Cloud Messaging ───────────────────────────────────────────────
FCM_SERVICE_ACCOUNT_PATH=           # path to firebase-adminsdk service account JSON

# ─── CORS / proxy ───────────────────────────────────────────────────────────
# Comma-separated origins. "*" is development-only: production refuses to boot
# with it.
CORS_ORIGIN=*
# true when something (nginx, Fly, Render, an ALB) sits in front of the API.
# Without it every request carries the proxy's IP and per-IP rate limiting
# collapses into one shared bucket.
TRUST_PROXY=false

# ─── Abuse control ──────────────────────────────────────────────────────────
RATE_LIMIT_MAX=300                  # global requests per window, per IP
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=20              # /auth/login + /auth/register per window, per IP
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
WEBHOOK_RATE_LIMIT_MAX=600          # payment/IoT webhooks per window, per IP
WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60

# ─── Worker ─────────────────────────────────────────────────────────────────
# 1 = run the overstay sweep inside the API process (development convenience).
# In production leave it unset/0 and run `npm run start:worker` as its own
# single-replica service, or every API instance sweeps the same sessions.
OVERSTAY_WORKER=1
