# ParkPeer web platform — environment template.
#
# Copy to website/.env.local for local development, or paste the same values into
# your host's environment settings (Vercel → Settings → Environment Variables)
# for a deploy. Restart the dev server after editing.
#
# With no Supabase values the whole platform still runs against the seed
# catalogue in src/lib/data/seed.ts — the map, the booking flow, the host console
# and the operator desk all work, and the HUD says "Seed catalogue" so nobody
# mistakes fixtures for live data.

# ─── Supabase — Project Settings → API ──────────────────────────────────────
# Public pair: shipped to the browser, safe because RLS governs every read.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS, so it must never be exposed to the client bundle —
# it carries no NEXT_PUBLIC_ prefix precisely so a stray import fails at build
# time instead of leaking. Every server action checks authorisation before use.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Site ───────────────────────────────────────────────────────────────────
# Absolute origin of this deployment. Used for redirects, canonical URLs,
# robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── ParkPeer Fastify backend (optional) ────────────────────────────────────
# Only needed by screens that talk to the REST API directly (QR minting, wallet
# reads). Leave empty to run purely on Supabase.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
